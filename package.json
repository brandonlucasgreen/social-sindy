{
  "name": "buffer-cal",
  "version": "0.1.0",
  "private": true,
  "description": "Sync your Buffer publishing schedule to Google Calendar, Apple Calendar, and Outlook via a subscribable iCalendar feed.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply buffer-cal --local",
    "db:migrate:remote": "wrangler d1 migrations apply buffer-cal --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "ical.js": "^2.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
